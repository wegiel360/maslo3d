rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lekka zmiana: zakaz fizycznego usuwania zamówień z klienta.
    // Anulowanie przez soft-delete (update isDeleted) w panelu; produkty/usuwanie zostają otwarte.
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /products/{productId} {
      allow read, write: if true;
      // Subkolekcje: chunki pliku 3D (model) i animacji 360 (preview).
      match /model/{chunkId} {
        allow read, write: if true;
      }
      match /preview/{chunkId} {
        allow read, write: if true;
      }
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}